# Copy to .env (chmod 600). Everything is optional; defaults shown.
# WARDROBE_HOST=192.168.0.129
# WARDROBE_PORT=8484
# WARDROBE_MAX_UPLOAD_MB=20
# WARDROBE_BACKUP_KEEP=7
# The stylist (Gemini API, free tier; called only from app/services/ai.py). Get a key at
# https://aistudio.google.com/apikey . Without it the app works, with random picks.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
